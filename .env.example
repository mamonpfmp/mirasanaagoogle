# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database (اختياري)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ==============================================================================
# إعدادات قاعدة بيانات Google Cloud SQL (PostgreSQL)
# ==============================================================================
# 1. الاتصال عبر IP أو Cloud SQL Auth Proxy:
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your-secure-db-password"
DB_NAME="afmis_db"
DB_SSL="false"

# 2. في حال النشر على Google Cloud Run / App Engine عبر Unix Socket:
# INSTANCE_CONNECTION_NAME="project-id:region:instance-id"

# ==============================================================================
# إعدادات أمان الخادم والتوكن (JWT & Security)
# ==============================================================================
JWT_SECRET="afmis-super-secure-jwt-secret-key-2026-mof-yemen"
JWT_EXPIRES_IN="24h"
PORT="3001"
CORS_ORIGIN="*"
